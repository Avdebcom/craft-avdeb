{% extends '_layout.twig' %}
{% block content %}
    <p class="kicker">Journal</p>
    <h1>Notes from the workbench</h1>
    <p class="meta">Small projects, desk upgrades and gift ideas.</p>
    <div class="grid">
        {% for entry in craft.entries().section('blog').all() %}
            <article class="teaser">
                <p class="kicker">{{ entry.postDate|date('M j, Y') }}</p>
                <h2><a href="{{ entry.url }}">{{ entry.title }}</a></h2>
                <p>{{ entry.body|replace({'</p>': '</p> ', '</h2>': '</h2> '})|striptags|replace('/\\{avdeb-[^}]*\\}/', '')|slice(0, 140)|trim }}…</p>
            </article>
        {% endfor %}
    </div>
    {% if craft.app.plugins.isPluginEnabled('avdeb') %}
        <section class="shop">
            {{ avdebProducts({ tag: '3d-prints', layout: 'spotlight', limit: 4, heading: 'Fresh off the 3D printer' }) }}
        </section>
    {% endif %}
{% endblock %}
