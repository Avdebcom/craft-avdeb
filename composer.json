{
    "name": "avdeb/craft-avdeb",
    "description": "Show AVDEB products (a creator shop, a category, a search or one product) on your Craft site with your affiliate referral code on every link.",
    "type": "craft-plugin",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "avdeb",
        "affiliate",
        "products",
        "embed",
        "stickers",
        "3d-printing"
    ],
    "homepage": "https://avdeb.com/developers/#craft",
    "license": "MIT",
    "authors": [
        {
            "name": "AVDEB",
            "homepage": "https://avdeb.com"
        }
    ],
    "support": {
        "docs": "https://github.com/Avdebcom/craft-avdeb#readme",
        "issues": "https://github.com/Avdebcom/craft-avdeb/issues",
        "source": "https://github.com/Avdebcom/craft-avdeb"
    },
    "require": {
        "php": ">=8.2",
        "craftcms/cms": "^5.0.0"
    },
    "autoload": {
        "psr-4": {
            "avdeb\\craftavdeb\\": "src/"
        }
    },
    "extra": {
        "handle": "avdeb",
        "name": "AVDEB Products",
        "developer": "AVDEB",
        "developerUrl": "https://avdeb.com",
        "documentationUrl": "https://github.com/Avdebcom/craft-avdeb#readme",
        "class": "avdeb\\craftavdeb\\Plugin"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    }
}
